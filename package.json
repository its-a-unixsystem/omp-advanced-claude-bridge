{
	"name": "omp-advanced-claude-bridge",
	"version": "0.8.1",
	"private": false,
	"description": "Fork of omp-claude-bridge: Oh My Pi 19.2+ extension that runs Claude Code (via the Claude Agent SDK) as an isolated per-session model provider, adds the AskClaude delegation tool, and exposes switchable 1M / 200K context windows.",
	"keywords": [
		"omp-package",
		"oh-my-pi",
		"extension",
		"claude-code",
		"claude-agent-sdk",
		"context-window",
		"1m-context"
	],
	"author": "Thomas Übermeier (https://github.com/its-a-unixsystem)",
	"contributors": [
		"Eli Dickinson (original pi-claude-bridge author, https://github.com/elidickinson)",
		"Jonathan Borgwing (omp-claude-bridge, the Oh My Pi port, https://github.com/DevVig)"
	],
	"license": "MIT",
	"homepage": "https://github.com/its-a-unixsystem/omp-advanced-claude-bridge#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/its-a-unixsystem/omp-advanced-claude-bridge.git"
	},
	"bugs": {
		"url": "https://github.com/its-a-unixsystem/omp-advanced-claude-bridge/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE",
		"NOTICE",
		"tsconfig.json",
		"assets"
	],
	"scripts": {
		"test": "node --import tsx --test tests/unit-*.mjs && bun test tests/",
		"test:unit": "node --import tsx --test tests/unit-*.mjs",
		"test:bridge": "bun test tests/",
		"typecheck": "tsc --noEmit"
	},
	"type": "module",
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.332",
		"cc-session-io": "^0.4.0",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-ai": "^19.2.1",
		"@oh-my-pi/pi-agent-core": "^19.2.1",
		"@oh-my-pi/pi-catalog": "^19.2.1",
		"@oh-my-pi/pi-coding-agent": "^19.2.1",
		"@oh-my-pi/pi-tui": "^19.2.1",
		"@oh-my-pi/pi-utils": "^19.2.1"
	},
	"peerDependenciesMeta": {
		"@oh-my-pi/pi-ai": {
			"optional": true
		},
		"@oh-my-pi/pi-agent-core": {
			"optional": true
		},
		"@oh-my-pi/pi-catalog": {
			"optional": true
		},
		"@oh-my-pi/pi-coding-agent": {
			"optional": true
		},
		"@oh-my-pi/pi-tui": {
			"optional": true
		},
		"@oh-my-pi/pi-utils": {
			"optional": true
		}
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.73.0",
		"@oh-my-pi/pi-ai": "19.2.1",
		"@oh-my-pi/pi-agent-core": "19.2.1",
		"@oh-my-pi/pi-catalog": "19.2.1",
		"@oh-my-pi/pi-coding-agent": "19.2.1",
		"@oh-my-pi/pi-tui": "19.2.1",
		"@oh-my-pi/pi-utils": "19.2.1",
		"@types/node": "^24.13.2",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	},
	"trustedDependencies": [
		"esbuild"
	],
	"omp": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
